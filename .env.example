# Copy to .env for local tools if you use env loaders (optional).
# GitHub Actions: set these in Settings → Secrets and variables → Actions.

NOTIFY_EMAIL=you@example.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password

